<% content_for :title, "Notes" %>
<div class="search">
  <h1>Notes</h1>
  <div class="search-meta">
    <% if @notes_by_conversation.any? %>
      Conversations with notes, most recently active first.
    <% else %>
      No notes yet. Open a conversation and use Notes in its header, or the note icon on a message.
    <% end %>
  </div>

  <% @notes_by_conversation.each do |conversation, notes| %>
    <section class="notes-group">
      <div class="hit-head">
        <%= link_to conversation.title, conversation_path(conversation), class: "hit-title" %>
        <span><%= conversation.project.name %></span>
      </div>
      <% notes.each do |note| %>
        <div class="notes-group-item">
          <% if note.message_uuid.nil? %>
            <div class="notes-group-label">Conversation</div>
          <% elsif (message = note.message) %>
            <%= link_to conversation_path(conversation, at: message.id, anchor: "message_#{message.id}"), class: "notes-group-label" do %>
              On <%= message.kind == "prompt" ? "your message" : "Claude's reply" %>: “<%= message.body.to_s.squish.truncate(80) %>”
            <% end %>
          <% else %>
            <div class="notes-group-label">On a message no longer in this session</div>
          <% end %>
          <div class="md"><%= markdown(note.body, cwd: conversation.cwd) %></div>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
