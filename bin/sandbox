#!/usr/bin/env bash
# Runs the app against the sample sessions in test/fixtures/files/claude, with its own databases.
# Every start rebuilds the sandbox databases, so each session begins from the same sample data.
set -euo pipefail
cd "$(dirname "$0")/.."

export RAILS_ENV=sandbox
# The sandbox isn't a "local" Rails environment, so it would otherwise need production credentials.
export SECRET_KEY_BASE_DUMMY=1
export PORT="${PORT:-3001}"

# Rebuilding the databases under a sandbox that is already running would corrupt its data.
if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "Port $PORT is already in use; stop the server running there first." >&2
  exit 1
fi

# The sample sessions' working directories, so their composers render. Sends still fail, since Claude Code has no such sessions.
mkdir -p /tmp/sample-shop /tmp/sample-api
rm -f storage/sandbox.sqlite3* storage/sandbox_queue.sqlite3*
bin/rails db:prepare
bin/rails runner 'Scanner.new.run; puts "Sandbox: #{Conversation.count} sample conversations at http://localhost:#{ENV["PORT"]}"'
exec bin/dev
